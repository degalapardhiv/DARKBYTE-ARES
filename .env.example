# ─────────────────────────────────────────────────────────────
# DARKBYTE ARES configuration
# Copy to .env and change every secret before exposing the app.
# ─────────────────────────────────────────────────────────────
APP_NAME="DARKBYTE ARES"
APP_ENV=development
DEBUG=false
DEMO_MODE=true
ALLOW_REGISTRATION=true
SECRET_KEY=change-me-to-a-random-64-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Database (Docker Compose overrides these)
DATABASE_URL=sqlite+aiosqlite:///./data/ares.db
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900

# Demo seed credentials; when DEMO_MODE=false, ADMIN_* provisions the first admin.
ADMIN_EMAIL=admin@ares.example.com
ADMIN_PASSWORD=Ares!Admin2026
ANALYST_EMAIL=analyst@ares.example.com
ANALYST_PASSWORD=Ares!Analyst2026

# Safety controls
MAX_SCAN_HOSTS=64
MAX_PORTS_PER_SCAN=512
SCAN_TIMEOUT_SECONDS=4
MAX_CONCURRENT_ASSESSMENTS=2
ASSESSMENT_TIMEOUT_SECONDS=180
RATE_LIMIT_PER_MINUTE=120
ACTIVE_SCAN_RATE_LIMIT=30
REQUIRE_VERIFIED_TARGETS=true
ALLOW_PRIVATE_TARGETS=true
ALLOW_LOOPBACK_LAB=true
LAB_MODE=true

# Intelligence sources
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
MITRE_ATTACK_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json
CRTSH_URL=https://crt.sh/

# Reporting
REPORTS_DIR=./data/reports
